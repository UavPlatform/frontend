{
  "name": "web",
  "private": true,
  "version": "0.0.0",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vue-tsc -b && vite build",
    "test": "vitest run",
    "preview": "vite preview",
    "api:sync": "node scripts/openapi-sync.mjs",
    "api:gen": "openapi-typescript openapi/drone-backend.openapi.json -o src/api/generated/openapi.d.ts",
    "api:check": "node scripts/openapi-check.mjs",
    "api": "pnpm run api:sync && pnpm run api:gen && pnpm run api:check"
  },
  "dependencies": {
    "@amap/amap-jsapi-loader": "^1.0.1",
    "@element-plus/icons-vue": "^2.3.2",
    "axios": "^1.13.6",
    "element-plus": "^2.13.5",
    "trtc-sdk-v5": "^5.16.0",
    "vue": "^3.5.30",
    "vue-router": "^5.0.4"
  },
  "devDependencies": {
    "@types/node": "^24.12.0",
    "@vitejs/plugin-vue": "^6.0.5",
    "@vue/test-utils": "^2.5.0",
    "@vue/tsconfig": "^0.9.0",
    "happy-dom": "^20.14.3",
    "openapi-typescript": "^7.13.0",
    "typescript": "~5.9.3",
    "unocss": "^66.6.7",
    "vite": "^8.0.0",
    "vitest": "^5.0.0",
    "vue-tsc": "^3.2.5"
  }
}
